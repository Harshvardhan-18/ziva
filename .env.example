# ZIVA — Environment Variables
# Copy this to .env and fill in your values.
# Never commit .env to version control.

# ── Zcash / Wallet ─────────────────────────────────────────────
# Testnet lightwalletd endpoint (use public testnet.zec.rocks or run your own)
LIGHTWALLETD_HOST=testnet.zec.rocks
LIGHTWALLETD_PORT=443
LIGHTWALLETD_TLS=true

# Wallet seed phrase (leave blank to generate a new wallet on first run)
# IMPORTANT: Back this up — it's the only key to your testnet wallet
WALLET_SEED=

# ── Rust Sidecar ──────────────────────────────────────────────
SIDECAR_PORT=3001
SIDECAR_HOST=0.0.0.0

# ── FastAPI Backend ───────────────────────────────────────────
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://ziva:ziva_dev_password@postgres:5432/ziva

# ── AI / Jev ─────────────────────────────────────────────────
# Option A: Direct TypeSafe API (requires approval)
TYPESAFE_API_KEY=

# Option B: Vercel AI Gateway (no waitlist — USE THIS)
AI_GATEWAY_API_KEY=

# LLM for LangGraph agents (GPT-4o recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=ziva
POSTGRES_PASSWORD=ziva_dev_password
POSTGRES_DB=ziva

# ── Next.js Dashboard ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── FROST (stretch goal) ──────────────────────────────────────
# FROST_THRESHOLD=2
# FROST_TOTAL_SIGNERS=3
# FROST_AMOUNT_THRESHOLD_ZAT=100000000
